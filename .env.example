# ResQSync backend configuration
RESQ_DB_HOST=localhost
RESQ_DB_PORT=3306
RESQ_DB_USER=root
RESQ_DB_PASSWORD=change-me
RESQ_DB_NAME=resqsync

# Optional hardware authentication. Leave unset for a local-only demo.
RESQ_HARDWARE_KEY=change-me

# Optional browser origins, comma-separated.
# RESQ_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Optional stale/route tuning values supported by helpers.py
# RESQ_GPS_STALE_SECONDS=15
# RESQ_NODE_TIMEOUT_SECONDS=30
# RESQ_CORRIDOR_RADIUS_M=300
